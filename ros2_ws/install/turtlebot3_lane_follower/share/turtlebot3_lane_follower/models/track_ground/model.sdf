<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="track_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>12 12 0.02</size>
          </box>
        </geometry>
        <pose>0 0 -0.01 0 0 0</pose>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>meshes/ground_plane.obj</uri>
          </mesh>
        </geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>materials/textures/track.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
